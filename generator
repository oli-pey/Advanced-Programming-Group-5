import os
from PIL import Image, ImageDraw, ImageFont

# Create directory for test digits
os.makedirs("test_digits", exist_ok=True)

def create_digit_image(digit, filename):
    # Create a 28x28 white image (L mode is 8-bit grayscale)
    # 255 is white in standard imaging packages like PIL
    img = Image.new('L', (28, 28), color=255)
    draw = ImageDraw.Draw(img)
    
    # Use a default font; size 20 usually fits well in a 28x28 canvas
    try:
        # Attempts to load a standard font, falls back to default if unavailable
        font = ImageFont.truetype("arial.ttf", 20)
    except IOError:
        font = ImageFont.load_default()

    # Calculate text position to center it
    # '0' is black in standard imaging packages like PIL
    draw.text((7, 2), str(digit), fill=0, font=font)
    
    img.save(f"test_digits/{filename}")

# Generate digits 0-9
for i in range(10):
    create_digit_image(i, f"my_digit{i}.png")

print("Created 10 black-on-white 28x28 images in the 'test_digits' folder.")